# Copy to .env and fill in. NEVER commit .env.
DJANGO_SETTINGS_MODULE=labourmax.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — local development
POSTGRES_DB=labourmax
POSTGRES_USER=labourmax
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application-level field encryption (ID numbers, bank accounts).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Email (console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Payment gateway (P1) — sandbox credentials only in dev
PAYMENT_GATEWAY=payfast
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_MERCHANT_KEY=
PAYMENT_GATEWAY_PASSPHRASE=
